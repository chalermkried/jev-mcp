# Remote proxy access: comma-separated, high-entropy bearer tokens.
MCP_ACCESS_TOKENS=
# Optional alternative: comma-separated SHA-256 hex digests of access tokens.
MCP_ACCESS_TOKEN_SHA256=
# Optional exact Origin allowlist. Requests with no Origin are accepted.
MCP_ALLOWED_ORIGINS=
# Optional model for either transport.
JEV_MCP_MODEL=jev-latest

# Remote Jev keys come ONLY from the X-Jev-Api-Key request header.
# TYPESAFE_API_KEY and other provider credentials are for local stdio use only.
